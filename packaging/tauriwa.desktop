[Desktop Entry]
Name=TauriWA
GenericName=WhatsApp Client
Comment=Simple desktop WhatsApp client for linux
Exec=tauriwa %U
Terminal=false
Type=Application
Icon=tauriwa
StartupWMClass=tauriwa
SingleMainWindow=true
MimeType=x-scheme-handler/whatsapp;
Categories=Network;Chat;InstantMessaging;X-WhatsApp;
